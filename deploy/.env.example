# Copy to deploy/.env (never commit .env) and fill in.

# Tailscale auth key: reusable, non-ephemeral, tagged tag:media-server
# (admin console -> Settings -> Keys -> Generate auth key).
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# TMDB API key (v3 key or v4 read access token). Leave empty to run without metadata.
TMDB_API_KEY=

# Host folder with your media (one broad parent, e.g. a whole disk). Mounted read-only at /media;
# choose the film and TV folders inside it in Administración → Bibliotecas.
MEDIA_DIR=/srv/media
